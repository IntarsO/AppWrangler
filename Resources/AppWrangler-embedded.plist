<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Linked into the AppWrangler binary (__TEXT,__info_plist), so a copy running
     outside the app bundle — the MCP server in AppWrangler-mcp-*.mcpb — has the
     same identity and preferences as the app. Version kept in sync by
     scripts/release.sh. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.intarso.AppWrangler</string>
	<key>CFBundleName</key>
	<string>AppWrangler</string>
	<key>CFBundleShortVersionString</key>
	<string>1.6.0</string>
</dict>
</plist>
